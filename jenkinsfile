pipeline {
    agent any  // run on any available node (master or slave)

    environment {
        PYTHON_ENV = "venv"
    }

    stages {

        stage('Checkout SCM') {
            steps {
                // Checkout main branch from GitHub
                checkout([$class: 'GitSCM', 
                          branches: [[name: '*/main']], 
                          userRemoteConfigs: [[url: 'https://github.com/hansikagollen/sign-language-detection']]])
            }
        }

        stage('Setup Python') {
            steps {
                bat """
                python -m venv %PYTHON_ENV%
                call %PYTHON_ENV%\\Scripts\\activate
                pip install --upgrade pip
                pip install -r requirements.txt
                """
            }
        }

        stage('Train Model') {
            steps {
                bat "call %PYTHON_ENV%\\Scripts\\activate && python train.py"
            }
        }

        stage('Run Prediction') {
            steps {
                bat "call %PYTHON_ENV%\\Scripts\\activate && python predict.py"
            }
        }
    }

    post {
        always {
            echo "Pipeline finished!"
        }
        success {
            echo "Build succeeded."
        }
        failure {
            echo "Build failed. Check logs."
        }
    }
}
