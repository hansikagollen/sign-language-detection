pipeline {
    agent any

    // 🕒 Schedule: runs daily at 2 AM
    triggers {
        cron('H 2 * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'emt', url: 'https://github.com/hansikagollen/sign-language-detection.git'
            }
        }

        stage('Setup Python') {
            steps {
                bat """
                python -m venv sld
                call sld\\Scripts\\activate
                python -m pip install --upgrade pip
                pip install -r requirements.txt
                """
            }
        }

        stage('Train Model') {
            steps {
                bat """
                call sld\\Scripts\\activate
                python train.py
                """
            }
        }

        stage('Test Model Loading') {
            steps {
                bat """
                call sld\\Scripts\\activate
                python -c "from tensorflow.keras.models import load_model; model = load_model('asl_model2.h5'); print('Model loaded successfully'); print(model.summary())"
                """
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '*.h5', allowEmptyArchive: true
            echo '✅ Pipeline finished. Check console logs and artifacts for details.'
        }
        failure {
            echo '❌ Pipeline failed. Check logs for errors.'
        }
    }
}
