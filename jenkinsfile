pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/hansikagollen/sign-language-detection'
            }
        }

        stage('Setup Python') {
            steps {
                bat """
                REM Create virtual environment with Python 3.10
                D:\\python-3.10.1-amd64.exe -m venv venv

                REM Activate virtual environment and upgrade pip
                call venv\\Scripts\\activate
                python -m pip install --upgrade pip

                REM Install required packages
                pip install -r requirements.txt
                pip install mediapipe==0.10.13.0
                """
            }
        }

        stage('Train Model') {
            steps {
                bat """
                call venv\\Scripts\\activate
                python train.py
                """
            }
        }

        stage('Run Prediction') {
            steps {
                bat """
                call venv\\Scripts\\activate
                python predict.py
                """
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished. Check console logs for details.'
        }
    }
}
